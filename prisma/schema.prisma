// The tenancy spine.
//
// Every model below is tenant-scoped, and that scoping is enforced in Postgres
// by row-level security rather than by discipline in application code — see the
// RLS migration for the policies, and `src/tenancy/tenancy.service.ts` for the
// helper that arms the transaction-local settings they read.
//
// `Tenant` itself carries no `tenantId`: its policy predicates on `id`, so a
// query inside one tenant's context sees exactly one Tenant row — its own.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id   String @id @default(uuid(7)) @db.Uuid
  slug String @unique
  name String

  /// The origins this Tenant's chat widget may be bootstrapped from.
  ///
  /// Empty by default, which means the widget is off: a Tenant that has not
  /// named an origin cannot mint a session at all. That is the right default
  /// for a public, unauthenticated endpoint — enabling the widget is a
  /// deliberate act, and a Tenant nobody configured is not quietly serving
  /// sessions to any page that asks.
  ///
  /// Serialized origins (`https://host[:port]`) rather than hostnames, because
  /// that is exactly what a browser puts in the `Origin` header and comparing
  /// anything else would mean parsing it back apart. See `origin-allowlist.ts`
  /// for the matching rule, which is deliberately exact — no wildcards, no
  /// subdomain suffixes.
  widgetOrigins String[] @map("widget_origins")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users          User[]
  contacts       Contact[]
  refreshTokens  RefreshToken[]
  invitations    StaffInvitation[]
  tickets        Ticket[]
  auditLog       AuditLog[]
  messages       Message[]
  notes          Note[]
  widgetSessions WidgetSession[]

  @@map("tenant")
}

/// An anonymous visitor's handle on a Tenant's own site.
///
/// The row exists for one reason the signed token could not serve: revocation.
/// A bearer token is valid until it expires, and "kill this one abusive visitor"
/// has no answer that does not also sign out every other visitor — rotating the
/// signing secret invalidates every session at once. A row per session makes the
/// answer a single UPDATE.
///
/// It carries the *mutable* half of a session, and the token carries only the
/// immutable half (`sessionId`, `tenantId`). That split is why a Contact
/// resolved in the middle of a conversation is picked up on the very next
/// request without re-minting anything, and why a token held by someone else
/// cannot assert a Contact the server did not put here.
///
/// Note what is absent: nothing identifying the visitor. No IP, no user agent,
/// no fingerprint. "Nothing durable is stored before they identify themselves"
/// is a claim about this table's columns, not a policy applied to it.
model WidgetSession {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The Contact this session speaks as, and null until one is *needed*.
  ///
  /// Deliberately not populated at mint. A visitor who opens the widget and
  /// reads nothing leaves no Contact behind; the row is created by the first act
  /// that requires a requester — opening a Ticket. This nullable column is the
  /// whole "anonymous until it matters" property, and it is also the seam a
  /// later identity-merge lands on: promoting this session's Contact into a
  /// known person changes what this column points at and nothing else.
  contactId String? @map("contact_id") @db.Uuid

  /// The 30-minute window, extended by renewal rather than replaced by a new
  /// session — so a long conversation keeps one session id and one Contact.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// Set to kill this session and no other. The whole reason the row exists.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite per ADR-0002, as every tenant-scoped reference is. Optional
  /// through its id half while `tenantId` stays required, exactly as
  /// `RefreshToken.contact` is.
  contact Contact? @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  // The only read this table has: one session by id, on every widget request.
  // The primary key serves it; this index serves the sweep that will eventually
  // reap expired rows, which is a tenant-scoped scan by expiry.
  @@index([tenantId, expiresAt])
  @@map("widget_session")
}

/// A User's authority within their Tenant. There are exactly two.
enum UserRole {
  agent
  admin

  @@map("user_role")
}

/// Internal staff of exactly one Tenant. Tenant-local by design: the same real
/// person working for two Tenants is two User rows, which is what lets every
/// table be tenant-scoped with no cross-tenant exception (ADR-0001).
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  name         String
  role         UserRole @default(agent)
  /// Argon2id. Nullable because membership precedes credentials: an invite
  /// creates the User, and only accepting it sets a password. A User with no
  /// hash cannot sign in — there is nothing to compare against.
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]
  /// Tickets this User is currently responsible for. There is no inverse for
  /// "tickets they closed" — that is an audit question, not a relation.
  assignedTickets Ticket[]          @relation("TicketAssignee")
  /// The invitation that provisioned this User, if one did.
  invitation      StaffInvitation?  @relation("InvitedUser")
  /// Invitations this User issued. Admin-only in practice, but the schema does
  /// not encode that — authority is the guard's business, not the FK's.
  invitationsSent StaffInvitation[] @relation("InvitingUser")

  // The login lookup key. Uniqueness is per tenant, never global.
  @@unique([tenantId, email])
  // Redundant on its own — `id` is already unique — but it is the target a
  // composite foreign key needs. See `Ticket.assignee` for why anything
  // referencing a User references `(tenantId, id)` rather than `id` alone.
  @@unique([tenantId, id])
  @@map("user")
}

/// One outstanding offer of tenant membership.
///
/// Membership is deliberate: there is no self-service registration anywhere in
/// this API, so every User arrives through a row here. The invitation carries
/// the single-use secret and nothing about authority — `role` is already on the
/// User row the invite provisioned, decided by the admin at issue time rather
/// than chosen by the person accepting.
///
/// Stored as `sha256(token)` for the same reason a refresh token is: a database
/// read must not yield a usable credential, and here the credential would grant
/// a foothold inside a tenant.
model StaffInvitation {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The pending User this invitation provisions. One invitation per User —
  /// re-inviting means revoking and issuing again, so there are never two live
  /// secrets for one seat.
  userId String @unique @map("user_id") @db.Uuid

  /// `sha256(token)`, hex. The raw token exists only in the mint response.
  tokenHash String @map("token_hash")

  /// The admin who issued it. Server-stamped from their credential, so the
  /// audit answer to "who let this person in" cannot be forged.
  invitedById String @map("invited_by_id") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// Set once, when the invitee sets a password. A row with a value here is
  /// spent; presenting its token again is refused rather than re-accepted.
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitingUser", fields: [invitedById], references: [id], onDelete: Cascade)

  // Presented invitations are looked up by hash alone, inside an armed context.
  @@unique([tenantId, tokenHash])
  @@map("staff_invitation")
}

/// One issued refresh token, stored as a hash and never as itself.
///
/// Rows are kept after rotation rather than deleted: an already-rotated row is
/// exactly what makes replay detectable. Presenting one is a theft signal, and
/// the response is to revoke every row sharing its `familyId` — the thief and
/// the victim both lose the session, which is the intended outcome.
model RefreshToken {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The session's subject, as an exclusive arc: exactly one of these is set,
  /// enforced by a check constraint rather than by the writer's care.
  ///
  /// Two nullable foreign keys rather than the polymorphic `authorKind`/`authorId`
  /// pair `Message` uses, and the two shapes are right for opposite reasons. A
  /// Message's author is one of *four* kinds including `system`, is read far more
  /// often than it is joined, and is what makes deflection a single GROUP BY —
  /// so giving up referential integrity buys something. Here the subject is one
  /// of exactly two kinds, both of which are real rows, and the column is only
  /// ever used to look one of them up. There is nothing to buy: an arc keeps the
  /// foreign keys, and the cascade that evicts a deleted principal's sessions.
  ///
  /// A staff session and a portal session are otherwise identical — same
  /// rotation, same family-wide replay eviction, same sliding and absolute
  /// windows — because they are the same mechanism serving two axes, not two
  /// mechanisms that happen to look alike.
  userId    String? @map("user_id") @db.Uuid
  contactId String? @map("contact_id") @db.Uuid

  /// `sha256(token)`, hex. The raw token exists only in the response cookie.
  /// Unhashed it would make a database read a set of usable credentials.
  tokenHash String @map("token_hash")

  /// Every token descended from one sign-in shares this. Rotation extends a
  /// family; replay destroys it.
  familyId String @map("family_id") @db.Uuid

  /// The sliding 30-day window. Refreshing issues a new row with a new one.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// The 90-day cap, copied unchanged onto every successor. Rotation cannot
  /// extend a session past the moment it began plus 90 days.
  familyExpiresAt DateTime @map("family_expires_at") @db.Timestamptz(3)

  /// Set when this token is spent (rotated) or revoked. A row with a value
  /// here is no longer usable; presenting one that was *rotated* is replay.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite per ADR-0002, as every tenant-scoped reference is — including
  /// the `user` arc, which was plain before this table learned a second subject.
  /// It is upgraded here rather than left alone: adding a correct constraint
  /// beside a known-weak one would make the table's own rules disagree, and the
  /// column was being altered anyway. Optional-to-optional, exactly as
  /// `AuditLog.ticket` is — the pair is nullable through its id half while
  /// `tenantId` stays required.
  user    User?    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  contact Contact? @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  // Presented tokens are looked up by hash alone. Unique per tenant rather
  // than globally: the hash is the lookup key inside an armed context, and RLS
  // already scopes the read.
  @@unique([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@map("refresh_token")
}

/// The tenant's end customer — the party a Ticket is from. May be unverified
/// (created from an anonymous widget visitor) or verified (portal OAuth or a
/// confirmed email).
model Contact {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  email    String?
  name     String?
  verified Boolean @default(false)

  /// Argon2id, as on `User`, and nullable for a stronger reason than there.
  /// Most Contacts never have one: a widget visitor is a Contact from their
  /// first Message and has no credential at all. A hash here is what makes a
  /// Contact able to sign into the portal, and signing in is only possible for
  /// a Contact that has been identified — so this column and `verified` move
  /// together in practice, without the schema claiming they must.
  ///
  /// The seam this leaves open is registration. Nothing in this API sets a
  /// Contact's password yet; the seed does it for the demo Contacts. A portal
  /// sign-up or a confirmed-email flow lands here and changes nothing else,
  /// because everything downstream reads the principal rather than the credential.
  passwordHash String? @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets        Ticket[]
  refreshTokens  RefreshToken[]
  /// The widget sessions that resolved to this Contact. Plural because one
  /// person can open the widget twice; merging those into one identity is
  /// deliberately not solved here, so today each session points at a Contact of
  /// its own.
  widgetSessions WidgetSession[]

  // No inverse for authored Messages. A Message's author is polymorphic —
  // `authorKind`/`authorId`, which can name a Contact, a User or a service
  // token — so it is not a foreign key and there is no relation to invert.
  // See `Message` for why that is a deliberate trade rather than a gap.

  // An anonymous Contact has no email, and Postgres treats NULLs as distinct,
  // so this constrains identified Contacts without collapsing anonymous ones.
  @@unique([tenantId, email])
  // The composite foreign-key target. See `Ticket.contact`.
  @@unique([tenantId, id])
  @@map("contact")
}

/// Where a Ticket came from. Fixed at creation and never edited: it is a fact
/// about how the conversation started, not a property of the work.
enum TicketSource {
  portal
  widget
  slack

  @@map("ticket_source")
}

/// A Ticket's progress. Five values, and `reopened` is deliberately not among
/// them — reopening is the transition `resolved → open`, so nothing downstream
/// has to special-case a near-duplicate of `open`.
///
/// Which pairs are legal is not expressible in this file, and the table is
/// deliberately written down in only one place: `ticket_transition_is_legal()`
/// in the state-machine migration, enforced by triggers on `ticket` that also
/// fix the birth state and emit the audit rows. Restating it here would be a
/// second copy that can drift from the one that decides. The single dimension
/// the database cannot judge — who may close, since that needs a credential —
/// is `src/tickets/state-machine.ts`.
enum TicketState {
  open
  pending
  on_hold
  resolved
  closed

  @@map("ticket_state")
}

/// A Ticket's urgency, and the sole key into SLA targets.
///
/// Orthogonal to state by design — any priority is valid in any state, and
/// changing one is never a transition. Urgency and progress are separate facts
/// about a Ticket and answering "how bad is this" must not require moving it.
enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

/// The unit of support work.
///
/// Born `open` and `normal`, always: new work is unambiguous and triage is an
/// explicit act rather than a state the creator chose. Both defaults live in
/// the database rather than in application code, so the guarantee holds for
/// the seed and for any future writer, not only for this API's create path.
model Ticket {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  subject String

  /// The requester, and required. Every Ticket is from someone: a Ticket with
  /// no Contact would have no one to reply to.
  contactId String @map("contact_id") @db.Uuid

  /// The single User responsible, or nobody. Optional because unassigned is
  /// the honest state of untriaged work — there is no `new` state standing in
  /// for it.
  assigneeId String? @map("assignee_id") @db.Uuid

  state    TicketState    @default(open)
  priority TicketPriority @default(normal)
  source   TicketSource

  /// The closed Ticket whose reply produced this one, and null on an origin
  /// Ticket. Exact ancestry: it names the direct parent, not the chain.
  ///
  /// Set at INSERT and immutable thereafter, enforced by a trigger rather than
  /// by the absence of an update path — "nothing writes this" is a claim about
  /// one port, and the append-only spirit here is the same one `AuditLog` has.
  spawnedFromTicketId String? @map("spawned_from_ticket_id") @db.Uuid

  /// The conversation's origin, denormalized, and null on an origin Ticket —
  /// "I am the root", stated by convention. Derived by the database from the
  /// parent (`parent.rootTicketId ?? parent.id`) and never supplied by a
  /// caller, so it cannot disagree with the ancestry it summarizes.
  ///
  /// A stored fact that is otherwise derivable, and the one thing it buys is
  /// the whole reason it exists: a conversation is a flat indexed lookup rather
  /// than a `WITH RECURSIVE`. That is *more* portable, not less — a recursive
  /// CTE is exactly the database-specific cleverness the three ports would each
  /// have to reimplement.
  rootTicketId String? @map("root_ticket_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite `(tenant_id, id)` rather than `id`, because foreign-key checks
  /// run with row-level security bypassed and a plain reference would accept
  /// another tenant's Contact. ADR-0002 has the argument; every tenant-scoped
  /// reference in this schema follows it.
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  /// Composite for the same reason — an assignee must be staff of this tenant,
  /// and the constraint is what says so.
  ///
  /// `Restrict` rather than `SetNull` is forced by that choice: a composite
  /// `SET NULL` would have to null `tenant_id` too, which is `NOT NULL`. The
  /// resulting rule is an honest one — a User holding Tickets cannot be deleted
  /// out from under them, and their queue is reassigned first. Nothing in this
  /// API deletes a User anyway; staff are deactivated, which leaves both the
  /// assignment and the history intact.
  assignee User? @relation("TicketAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict)

  /// The two linkage pointers, composite per ADR-0002 like every other
  /// tenant-scoped reference — and it earns its keep here, since a plain
  /// `id` reference would be satisfied by another tenant's Ticket and would
  /// turn the chain read into a cross-tenant join.
  ///
  /// `Cascade` rather than `SetNull`, which a composite reference cannot express
  /// anyway (it would have to null `tenantId`, which is `NOT NULL` — the same
  /// forced choice `assignee` records in reverse). It is also the honest rule: a
  /// spawned Ticket whose parent was hard-deleted would point at nothing, and
  /// `ticket:delete` is already understood to take the conversation with it.
  spawnedFrom  Ticket?  @relation("TicketSpawn", fields: [tenantId, spawnedFromTicketId], references: [tenantId, id], onDelete: Cascade)
  spawned      Ticket[] @relation("TicketSpawn")
  root         Ticket?  @relation("TicketChain", fields: [tenantId, rootTicketId], references: [tenantId, id], onDelete: Cascade)
  /// Every descendant in the chain, in one hop. This is the relation the
  /// conversation read exists for — no recursion, one index.
  chain        Ticket[] @relation("TicketChain")

  /// The control-plane record for this Ticket. Not a cascade: entries outlive
  /// the Ticket they describe — see `AuditLog.ticket`.
  auditLog AuditLog[]

  /// The customer-visible thread, and the agent-only one beside it. Two
  /// relations because they are two tables — see `Note` for why that is the
  /// whole point rather than a normalization choice.
  messages Message[]
  notes    Note[]

  // The composite foreign-key target, as on `Contact` and `User`. Redundant as
  // a uniqueness claim — `id` is already unique — and present only so anything
  // referencing a Ticket can reference `(tenant_id, id)`. See `AuditLog.ticket`.
  @@unique([tenantId, id])
  // The queue reads. Every one of these is `tenantId`-leading because every
  // query runs inside a tenant context — an index that omitted it would be
  // unusable for the only access pattern this table has.
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  // The second sortable field. Both keyset orderings need `(field, id)` to be
  // servable, so a field becoming sortable and a field getting an index are
  // the same decision — see `TICKET_SORTABLE`.
  @@index([tenantId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, state, createdAt(sort: Desc)])
  @@index([tenantId, assigneeId, createdAt(sort: Desc)])
  @@index([tenantId, contactId])
  // The conversation read: a chain's descendants by this index, its origin by
  // primary key. Ordered by `createdAt` because that is the order the
  // conversation happened in, which is the only order it reads as a narrative.
  @@index([tenantId, rootTicketId, createdAt])
  // Not expressible here, and stated in the migration instead: a unique partial
  // index on `(tenantId, COALESCE(rootTicketId, id)) WHERE state <> 'closed'`,
  // which is the re-reply invariant — at most one live Ticket per chain, so a
  // burst of replies cannot fan out into duplicates. Prisma manages neither
  // expression indexes nor the `ticket_linkage_is_whole` check beside it.
  @@map("ticket")
}

/// The kinds of thing that can act, mirroring `ACTOR_KINDS` in
/// `src/tenancy/tenant-context.ts`.
enum ActorKind {
  user
  contact
  service
  system

  @@map("actor_kind")
}

/// The closed catalog of audited events.
///
/// Closed rather than an open envelope: a newly audited event is an honest
/// schema fact and should cost a migration. `ticket.transitioned` is one action
/// rather than one per state pair, and `sla.breached` is one action with
/// `metadata.kind` separating first-response from resolution — analytics reads
/// the SLA latch columns rather than this table, so splitting it would buy
/// nothing.
///
/// Reserved, and deliberately absent until it has a write path: `contact.merged`,
/// which lands with the Contact identity-merge seam.
enum AuditAction {
  ticket_created          @map("ticket.created")
  ticket_transitioned     @map("ticket.transitioned")
  ticket_assigned         @map("ticket.assigned")
  ticket_priority_changed @map("ticket.priority_changed")
  sla_breached            @map("sla.breached")
  token_minted            @map("token.minted")
  token_revoked           @map("token.revoked")
  integration_failed      @map("integration.failed")

  @@map("audit_action")
}

/// An append-only record of who changed the state or configuration of the
/// system, and what it was before.
///
/// Control-plane only. Message and Note *content* is never recorded here:
/// conversation is domain data, attributed on its own rows, and duplicating it
/// would drown the signal this table carries. The state changes a message
/// *causes* — an auto-reopen, say — are audited; the message is not.
///
/// Three of the guarantees below are not expressible in this file and live in
/// the migration instead, because they must hold for the Spring and FastAPI
/// ports as well as for this one: UPDATE and DELETE are revoked and additionally
/// refused by a trigger, so history cannot be rewritten; the actor is stamped
/// from the armed context by a trigger rather than supplied; and an insert
/// reaching the table with no actor in context raises rather than defaulting to
/// `system`.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Defaulted from `app.current_tenant` for the same reason the actor is
  /// stamped: on this table, provenance comes from the armed context rather
  /// than from the caller. The tenant policy's `WITH CHECK` is the backstop —
  /// a row naming another tenant is refused outright.
  tenantId String @default(dbgenerated("NULLIF(current_setting('app.current_tenant', true), '')::uuid")) @map("tenant_id") @db.Uuid

  action AuditAction

  /// Never supplied at the insert site. The default makes the column optional
  /// to Prisma; the trigger is what makes it un-forgeable.
  actorKind ActorKind @default(dbgenerated("current_actor_kind()")) @map("actor_kind")

  /// Null exactly when `actorKind` is `system`, which is the one actor with no
  /// row to point at. A check constraint enforces the equivalence.
  actorId String? @default(dbgenerated("current_actor_id()")) @map("actor_id") @db.Uuid

  /// Polymorphic target. Text rather than an enum: the *action* catalog is the
  /// closed vocabulary this table commits to, and closing the target set too
  /// would mean a migration whenever an existing action learned to point at a
  /// new kind of row.
  targetKind String @map("target_kind")
  targetId   String @map("target_id") @db.Uuid

  /// The per-ticket timeline's key. A real column rather than a read of
  /// `targetId`, because most rows target something that merely *belongs* to a
  /// Ticket rather than the Ticket itself.
  ticketId String? @map("ticket_id") @db.Uuid

  /// Old and new, as plain text. Transitions, priority changes and assignments
  /// are all old→new pairs; typing these as any one domain enum would couple
  /// the table to every enum in the schema. `action` says how to read them.
  fromValue String? @map("from_value")
  toValue   String? @map("to_value")

  /// The irregular tail — minted scopes, dead-letter target and error, the
  /// `sla.breached` kind. Anything that is real structure is a column above.
  metadata Json? @db.JsonB

  /// Ties one request's cascade of rows together. Unset for now: there is no
  /// request id in the pipeline yet, and inventing one per row would tie
  /// nothing to anything.
  correlationId String? @map("correlation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// `Restrict`, where every other tenant-scoped table cascades. A cascade is a
  /// DELETE, and DELETE on this table is refused — so the two would be opposite
  /// instructions, and Postgres would surface the conflict as an append-only
  /// error raised from inside a `DELETE FROM tenant`. `Restrict` states the real
  /// rule instead: a Tenant with history cannot be hard-deleted. See the
  /// migration for why that constraint is honest rather than incidental.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Composite per ADR-0002, and `NoAction` here only because Prisma's schema
  /// language cannot express what the migration actually declares:
  /// `ON DELETE SET NULL (ticket_id)`. Postgres 15's column list narrows the
  /// clause to the one column, which is what lets this reference be composite
  /// *and* survive the deletion of its subject — ADR-0002 records the bare form
  /// as impossible, and the amendment is noted there. Prisma does not manage
  /// this constraint; the migration does.
  ticket Ticket? @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, ticketId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_log")
}

/// A customer-visible entry in a Ticket's thread.
///
/// The counterpart to `Note`, and the reason the two are separate tables is
/// written up there. What belongs here is what a Message *is*: the thing the
/// Contact can read. Every row in this table is publishable to the requester by
/// definition, so "may this person see it" is never a per-row question.
///
/// There is no update path and no `updatedAt`. A Message is an utterance — it
/// was sent, the Contact may already have read it, and a later correction is
/// another Message rather than a rewrite of the first. This is a product claim
/// rather than a database-enforced one: UPDATE is granted as it is on every
/// other domain table, because redaction is a real requirement that will
/// eventually arrive and it should arrive as a considered write path, not by
/// re-granting a privilege the schema had taken away.
model Message {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  /// What was said. Plain text on the wire; rendering is the console's
  /// business, and storing markup would make this column a security surface.
  body String

  /// Who said it, stamped from the armed context by a trigger rather than
  /// supplied — see `authorId`, and `conversation_stamp_author()` in the
  /// migration, which stamps this table and `note` alike.
  authorKind ActorKind @default(dbgenerated("current_actor_kind()")) @map("author_kind")

  /// The polymorphic half. Not a foreign key, and that is the trade this shape
  /// makes: a Message can be authored by a User, a Contact or a ServiceToken,
  /// and three nullable exclusive-arc columns would be a worse lie — every
  /// reader would still have to branch, and two of the three would always be
  /// null. Referential integrity is given up for one column that always answers
  /// "who", which is what makes deflection — the share of Messages authored by
  /// `service` — a single GROUP BY rather than a join across three arcs.
  ///
  /// Null exactly when `authorKind` is `system`, the one actor with no row to
  /// point at. A check constraint enforces the equivalence.
  authorId String? @default(dbgenerated("current_actor_id()")) @map("author_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite per ADR-0002, and `Cascade` unlike `AuditLog.ticket`: a thread
  /// is part of the Ticket rather than a record about it, so it has no meaning
  /// once the Ticket is gone.
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  // The only read this table has: one Ticket's thread, keyset-paginated. The
  // `(createdAt, id)` tail is what makes that traversal servable, and a DESC
  // index serves the ascending scan too — Postgres reads it backwards.
  @@index([tenantId, ticketId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("message")
}

/// An agent-only internal entry on a Ticket, never visible to a Contact.
///
/// A separate table rather than `Message.internal = true`, and this is the one
/// decision the conversation model is built around. A boolean would make every
/// customer-facing read a query that must remember to filter — the endpoint
/// that serves the portal, the widget's transcript, an export, the AI layer's
/// context window — and each of those is one forgotten `WHERE` away from
/// showing a customer what an agent said about them. Here there is no clause to
/// forget: the customer-visible read names `message`, and a Note is not in it.
/// Invisibility is structural, so the failure mode is a missing feature rather
/// than a leak.
///
/// Deliberately the same shape as `Message` down to the column names, so the
/// two thread reads are the same code path with a different table — and *not*
/// a shared base table with a discriminator, which would put them back in one
/// place and hand the boolean its `WHERE` clause again.
model Note {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  ticketId String @map("ticket_id") @db.Uuid

  body String

  /// Polymorphic and stamped by `conversation_stamp_author()`, exactly as on
  /// `Message`.
  ///
  /// Not narrowed to `user`, though a Contact authoring an agent-only entry is
  /// incoherent. Two reasons: the AI layer writes Notes under a `service`
  /// actor, and a Contact never reaches this table anyway — `note:write` is not
  /// in any grant a Contact can hold, so the exclusion is already enforced by
  /// the authorization model rather than needing a second statement of it here.
  authorKind ActorKind @default(dbgenerated("current_actor_kind()")) @map("author_kind")
  authorId   String?   @default(dbgenerated("current_actor_id()")) @map("author_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, ticketId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("note")
}
