// The tenancy spine.
//
// Every model below is tenant-scoped, and that scoping is enforced in Postgres
// by row-level security rather than by discipline in application code — see the
// RLS migration for the policies, and `src/tenancy/tenancy.service.ts` for the
// helper that arms the transaction-local settings they read.
//
// `Tenant` itself carries no `tenantId`: its policy predicates on `id`, so a
// query inside one tenant's context sees exactly one Tenant row — its own.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users         User[]
  contacts      Contact[]
  refreshTokens RefreshToken[]
  invitations   StaffInvitation[]
  tickets       Ticket[]
  auditLog      AuditLog[]

  @@map("tenant")
}

/// A User's authority within their Tenant. There are exactly two.
enum UserRole {
  agent
  admin

  @@map("user_role")
}

/// Internal staff of exactly one Tenant. Tenant-local by design: the same real
/// person working for two Tenants is two User rows, which is what lets every
/// table be tenant-scoped with no cross-tenant exception (ADR-0001).
model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String
  name      String
  role      UserRole @default(agent)
  /// Argon2id. Nullable because membership precedes credentials: an invite
  /// creates the User, and only accepting it sets a password. A User with no
  /// hash cannot sign in — there is nothing to compare against.
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  /// Tickets this User is currently responsible for. There is no inverse for
  /// "tickets they closed" — that is an audit question, not a relation.
  assignedTickets Ticket[]     @relation("TicketAssignee")
  /// The invitation that provisioned this User, if one did.
  invitation    StaffInvitation? @relation("InvitedUser")
  /// Invitations this User issued. Admin-only in practice, but the schema does
  /// not encode that — authority is the guard's business, not the FK's.
  invitationsSent StaffInvitation[] @relation("InvitingUser")

  // The login lookup key. Uniqueness is per tenant, never global.
  @@unique([tenantId, email])
  // Redundant on its own — `id` is already unique — but it is the target a
  // composite foreign key needs. See `Ticket.assignee` for why anything
  // referencing a User references `(tenantId, id)` rather than `id` alone.
  @@unique([tenantId, id])
  @@map("user")
}

/// One outstanding offer of tenant membership.
///
/// Membership is deliberate: there is no self-service registration anywhere in
/// this API, so every User arrives through a row here. The invitation carries
/// the single-use secret and nothing about authority — `role` is already on the
/// User row the invite provisioned, decided by the admin at issue time rather
/// than chosen by the person accepting.
///
/// Stored as `sha256(token)` for the same reason a refresh token is: a database
/// read must not yield a usable credential, and here the credential would grant
/// a foothold inside a tenant.
model StaffInvitation {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// The pending User this invitation provisions. One invitation per User —
  /// re-inviting means revoking and issuing again, so there are never two live
  /// secrets for one seat.
  userId String @unique @map("user_id") @db.Uuid

  /// `sha256(token)`, hex. The raw token exists only in the mint response.
  tokenHash String @map("token_hash")

  /// The admin who issued it. Server-stamped from their credential, so the
  /// audit answer to "who let this person in" cannot be forged.
  invitedById String @map("invited_by_id") @db.Uuid

  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// Set once, when the invitee sets a password. A row with a value here is
  /// spent; presenting its token again is refused rather than re-accepted.
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitingUser", fields: [invitedById], references: [id], onDelete: Cascade)

  // Presented invitations are looked up by hash alone, inside an armed context.
  @@unique([tenantId, tokenHash])
  @@map("staff_invitation")
}

/// One issued refresh token, stored as a hash and never as itself.
///
/// Rows are kept after rotation rather than deleted: an already-rotated row is
/// exactly what makes replay detectable. Presenting one is a theft signal, and
/// the response is to revoke every row sharing its `familyId` — the thief and
/// the victim both lose the session, which is the intended outcome.
model RefreshToken {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid

  /// `sha256(token)`, hex. The raw token exists only in the response cookie.
  /// Unhashed it would make a database read a set of usable credentials.
  tokenHash String @map("token_hash")

  /// Every token descended from one sign-in shares this. Rotation extends a
  /// family; replay destroys it.
  familyId String @map("family_id") @db.Uuid

  /// The sliding 30-day window. Refreshing issues a new row with a new one.
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  /// The 90-day cap, copied unchanged onto every successor. Rotation cannot
  /// extend a session past the moment it began plus 90 days.
  familyExpiresAt DateTime @map("family_expires_at") @db.Timestamptz(3)

  /// Set when this token is spent (rotated) or revoked. A row with a value
  /// here is no longer usable; presenting one that was *rotated* is replay.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Presented tokens are looked up by hash alone. Unique per tenant rather
  // than globally: the hash is the lookup key inside an armed context, and RLS
  // already scopes the read.
  @@unique([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@map("refresh_token")
}

/// The tenant's end customer — the party a Ticket is from. May be unverified
/// (created from an anonymous widget visitor) or verified (portal OAuth or a
/// confirmed email).
model Contact {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  email     String?
  name      String?
  verified  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  // An anonymous Contact has no email, and Postgres treats NULLs as distinct,
  // so this constrains identified Contacts without collapsing anonymous ones.
  @@unique([tenantId, email])
  // The composite foreign-key target. See `Ticket.contact`.
  @@unique([tenantId, id])
  @@map("contact")
}

/// Where a Ticket came from. Fixed at creation and never edited: it is a fact
/// about how the conversation started, not a property of the work.
enum TicketSource {
  portal
  widget
  slack

  @@map("ticket_source")
}

/// A Ticket's progress. Five values, and `reopened` is deliberately not among
/// them — reopening is the transition `resolved → open`, so nothing downstream
/// has to special-case a near-duplicate of `open`.
///
/// Which pairs are legal is not expressible in this file, and the table is
/// deliberately written down in only one place: `ticket_transition_is_legal()`
/// in the state-machine migration, enforced by triggers on `ticket` that also
/// fix the birth state and emit the audit rows. Restating it here would be a
/// second copy that can drift from the one that decides. The single dimension
/// the database cannot judge — who may close, since that needs a credential —
/// is `src/tickets/state-machine.ts`.
enum TicketState {
  open
  pending
  on_hold
  resolved
  closed

  @@map("ticket_state")
}

/// A Ticket's urgency, and the sole key into SLA targets.
///
/// Orthogonal to state by design — any priority is valid in any state, and
/// changing one is never a transition. Urgency and progress are separate facts
/// about a Ticket and answering "how bad is this" must not require moving it.
enum TicketPriority {
  low
  normal
  high
  urgent

  @@map("ticket_priority")
}

/// The unit of support work.
///
/// Born `open` and `normal`, always: new work is unambiguous and triage is an
/// explicit act rather than a state the creator chose. Both defaults live in
/// the database rather than in application code, so the guarantee holds for
/// the seed and for any future writer, not only for this API's create path.
model Ticket {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  subject String

  /// The requester, and required. Every Ticket is from someone: a Ticket with
  /// no Contact would have no one to reply to.
  contactId String @map("contact_id") @db.Uuid

  /// The single User responsible, or nobody. Optional because unassigned is
  /// the honest state of untriaged work — there is no `new` state standing in
  /// for it.
  assigneeId String? @map("assignee_id") @db.Uuid

  state    TicketState    @default(open)
  priority TicketPriority @default(normal)
  source   TicketSource

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Composite `(tenant_id, id)` rather than `id`, because foreign-key checks
  /// run with row-level security bypassed and a plain reference would accept
  /// another tenant's Contact. ADR-0002 has the argument; every tenant-scoped
  /// reference in this schema follows it.
  contact Contact @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Cascade)

  /// Composite for the same reason — an assignee must be staff of this tenant,
  /// and the constraint is what says so.
  ///
  /// `Restrict` rather than `SetNull` is forced by that choice: a composite
  /// `SET NULL` would have to null `tenant_id` too, which is `NOT NULL`. The
  /// resulting rule is an honest one — a User holding Tickets cannot be deleted
  /// out from under them, and their queue is reassigned first. Nothing in this
  /// API deletes a User anyway; staff are deactivated, which leaves both the
  /// assignment and the history intact.
  assignee User? @relation("TicketAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict)

  /// The control-plane record for this Ticket. Not a cascade: entries outlive
  /// the Ticket they describe — see `AuditLog.ticket`.
  auditLog AuditLog[]

  // The queue reads. Every one of these is `tenantId`-leading because every
  // query runs inside a tenant context — an index that omitted it would be
  // unusable for the only access pattern this table has.
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)])
  // The second sortable field. Both keyset orderings need `(field, id)` to be
  // servable, so a field becoming sortable and a field getting an index are
  // the same decision — see `TICKET_SORTABLE`.
  @@index([tenantId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([tenantId, state, createdAt(sort: Desc)])
  @@index([tenantId, assigneeId, createdAt(sort: Desc)])
  @@index([tenantId, contactId])
  // The composite foreign-key target, as on `Contact` and `User`. Redundant as
  // a uniqueness claim — `id` is already unique — and present only so anything
  // referencing a Ticket can reference `(tenant_id, id)`. See `AuditLog.ticket`.
  @@unique([tenantId, id])
  @@map("ticket")
}

/// The kinds of thing that can act, mirroring `ACTOR_KINDS` in
/// `src/tenancy/tenant-context.ts`.
enum ActorKind {
  user
  contact
  service
  system

  @@map("actor_kind")
}

/// The closed catalog of audited events.
///
/// Closed rather than an open envelope: a newly audited event is an honest
/// schema fact and should cost a migration. `ticket.transitioned` is one action
/// rather than one per state pair, and `sla.breached` is one action with
/// `metadata.kind` separating first-response from resolution — analytics reads
/// the SLA latch columns rather than this table, so splitting it would buy
/// nothing.
///
/// Reserved, and deliberately absent until it has a write path: `contact.merged`,
/// which lands with the Contact identity-merge seam.
enum AuditAction {
  ticket_created          @map("ticket.created")
  ticket_transitioned     @map("ticket.transitioned")
  ticket_assigned         @map("ticket.assigned")
  ticket_priority_changed @map("ticket.priority_changed")
  sla_breached            @map("sla.breached")
  token_minted            @map("token.minted")
  token_revoked           @map("token.revoked")
  integration_failed      @map("integration.failed")

  @@map("audit_action")
}

/// An append-only record of who changed the state or configuration of the
/// system, and what it was before.
///
/// Control-plane only. Message and Note *content* is never recorded here:
/// conversation is domain data, attributed on its own rows, and duplicating it
/// would drown the signal this table carries. The state changes a message
/// *causes* — an auto-reopen, say — are audited; the message is not.
///
/// Three of the guarantees below are not expressible in this file and live in
/// the migration instead, because they must hold for the Spring and FastAPI
/// ports as well as for this one: UPDATE and DELETE are revoked and additionally
/// refused by a trigger, so history cannot be rewritten; the actor is stamped
/// from the armed context by a trigger rather than supplied; and an insert
/// reaching the table with no actor in context raises rather than defaulting to
/// `system`.
model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  /// Defaulted from `app.current_tenant` for the same reason the actor is
  /// stamped: on this table, provenance comes from the armed context rather
  /// than from the caller. The tenant policy's `WITH CHECK` is the backstop —
  /// a row naming another tenant is refused outright.
  tenantId String @default(dbgenerated("NULLIF(current_setting('app.current_tenant', true), '')::uuid")) @map("tenant_id") @db.Uuid

  action AuditAction

  /// Never supplied at the insert site. The default makes the column optional
  /// to Prisma; the trigger is what makes it un-forgeable.
  actorKind ActorKind @default(dbgenerated("current_actor_kind()")) @map("actor_kind")

  /// Null exactly when `actorKind` is `system`, which is the one actor with no
  /// row to point at. A check constraint enforces the equivalence.
  actorId String? @default(dbgenerated("current_actor_id()")) @map("actor_id") @db.Uuid

  /// Polymorphic target. Text rather than an enum: the *action* catalog is the
  /// closed vocabulary this table commits to, and closing the target set too
  /// would mean a migration whenever an existing action learned to point at a
  /// new kind of row.
  targetKind String @map("target_kind")
  targetId   String @map("target_id") @db.Uuid

  /// The per-ticket timeline's key. A real column rather than a read of
  /// `targetId`, because most rows target something that merely *belongs* to a
  /// Ticket rather than the Ticket itself.
  ticketId String? @map("ticket_id") @db.Uuid

  /// Old and new, as plain text. Transitions, priority changes and assignments
  /// are all old→new pairs; typing these as any one domain enum would couple
  /// the table to every enum in the schema. `action` says how to read them.
  fromValue String? @map("from_value")
  toValue   String? @map("to_value")

  /// The irregular tail — minted scopes, dead-letter target and error, the
  /// `sla.breached` kind. Anything that is real structure is a column above.
  metadata Json? @db.JsonB

  /// Ties one request's cascade of rows together. Unset for now: there is no
  /// request id in the pipeline yet, and inventing one per row would tie
  /// nothing to anything.
  correlationId String? @map("correlation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// `Restrict`, where every other tenant-scoped table cascades. A cascade is a
  /// DELETE, and DELETE on this table is refused — so the two would be opposite
  /// instructions, and Postgres would surface the conflict as an append-only
  /// error raised from inside a `DELETE FROM tenant`. `Restrict` states the real
  /// rule instead: a Tenant with history cannot be hard-deleted. See the
  /// migration for why that constraint is honest rather than incidental.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  /// Composite per ADR-0002, and `NoAction` here only because Prisma's schema
  /// language cannot express what the migration actually declares:
  /// `ON DELETE SET NULL (ticket_id)`. Postgres 15's column list narrows the
  /// clause to the one column, which is what lets this reference be composite
  /// *and* survive the deletion of its subject — ADR-0002 records the bare form
  /// as impossible, and the amendment is noted there. Prisma does not manage
  /// this constraint; the migration does.
  ticket Ticket? @relation(fields: [tenantId, ticketId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId, ticketId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("audit_log")
}
