# Nivara Desk API — configuration
#
# Copy to `.env` for a non-compose local run. `.env` is gitignored and nothing
# real is ever committed. `docker compose up` needs none of this: compose bakes
# in throwaway defaults, so a clean clone runs with no credentials at all.
#
# Every key the application reads is documented here. Keys marked OPTIONAL may
# be omitted entirely — the capability is dormant, never fatal. Where a key
# comes in a set, supply all of the set or none of it: a half-configured
# integration fails at boot rather than at first use.

# --- Core -------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=3000

# --- Infrastructure ---------------------------------------------------------

# Runtime connects as the least-privileged, non-BYPASSRLS `app_user` over the
# pooled endpoint. Row-level security is the backstop beneath every query, so
# the runtime role must never be able to bypass it.
DATABASE_URL=postgres://app_user:password@localhost:5432/nivara

# Owner credential over the *direct* (unpooled) endpoint. Read by the Prisma
# CLI (see prisma.config.ts) and by nothing in the application.
#
# It belongs to the release-phase migrate step alone and must never be present
# in the running process's environment — that is what keeps the runtime unable
# to bypass RLS. A production process that finds it set refuses to boot. In
# development and test one .env legitimately serves both, as it does here.
MIGRATE_DATABASE_URL=postgres://nivara_owner:password@localhost:5432/nivara

REDIS_URL=redis://localhost:6379

# --- Secrets ----------------------------------------------------------------

# Signs staff access tokens. Required, minimum 32 characters — a short secret
# is a forgeable token, not a visible error. Generate with:
#   openssl rand -base64 32
JWT_SECRET=

# Signs anonymous widget sessions. Generate with: openssl rand -base64 32
WIDGET_SESSION_SECRET=

# --- OPTIONAL: Google OIDC staff login --------------------------------------
# Omit both to leave Google sign-in dormant. The seeded email/password logins
# are the key-free demo path, so nothing here is needed to evaluate the API.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OPTIONAL: Slack source adapter -----------------------------------------
# Omit both to leave Slack ingestion dormant.

SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# --- Runtime flags ----------------------------------------------------------

# Runs the in-process scheduler ticker. On for the deployed web service; the
# flag is what keeps splitting the scheduler into its own service a deploy
# change rather than a rewrite.
RUN_SCHEDULER=false

# Serves the generated OpenAPI document at /docs and /openapi.json.
SWAGGER_ENABLED=true
